{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EM T PC",
  "version": "0.1.0",
  "identifier": "com.emtpc.security-training",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EM T PC | Siber Güvenlik Eğitim Merkezi",
        "width": 920,
        "height": 720,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true
      },
      {
        "label": "terminal",
        "title": "EM T PC Terminal",
        "url": "terminal.html",
        "width": 900,
        "height": 600,
        "minWidth": 700,
        "minHeight": 420,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}
